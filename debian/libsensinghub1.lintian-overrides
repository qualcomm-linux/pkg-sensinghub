# The project creates multiple shared libraries that would be busywork to keep
# in separate packages given that they all have the same soversion.
package-name-doesnt-match-sonames libqshUtil1 libsensinghubapi-c1 libsensinghubapi1 libsensinghublogger1 libsensinghubsession1

# Upstream is explicitly not using copyright years, respect that.
copyright-without-copyright-notice

# Upstream does not seem to properly use visibility=hidden and manually
# export a reduced set of symbols as explained here:
# https://wiki.debian.org/UsingSymbolsFiles#Proper_visibility_for_C.2B-.2B-_symbols
no-symbols-control-file
